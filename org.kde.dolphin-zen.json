{
    "id": "org.kde.dolphin-zen",
    "branch": "main",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "dolphin-zen",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=host",
        "--filesystem=~/.var/app/",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.kde.kded6",
        "--talk-name=org.kde.kiod6",
        "--talk-name=org.kde.JobViewServer",
        "--talk-name=org.kde.kpasswdserver",
        "--talk-name=org.kde.kpasswdserver6",
        "--talk-name=org.kde.kuiserver",
        "--system-talk-name=org.freedesktop.UDisks2"
    ],
    "modules": [
        {
            "name": "lmdb",
            "no-autogen": true,
            "subdir": "libraries/liblmdb",
            "make-install-args": [
                "prefix=/app"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/LMDB/lmdb.git",
                    "tag": "LMDB_0.9.35",
                    "commit": "69087ced3cb6082f7dcfb4fc2dcaa3b68a7e2e8c"
                }
            ]
        },
        {
            "name": "baloo",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DBUILD_TESTING=OFF",
                "-DLMDB_DIR=/app"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/frameworks/baloo.git",
                    "tag": "v6.31.0"
                }
            ]
        },
        {
            "name": "baloo-widgets",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DBUILD_TESTING=OFF",
                "-DQT_MAJOR_VERSION=6",
                "-DLMDB_DIR=/app"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/libraries/baloo-widgets.git",
                    "tag": "v26.08.2"
                }
            ]
        },
        {
            "name": "dolphin-zen",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DFLATPAK=ON",
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".flatpak-builder",
                        "flatpak-build-dir",
                        "build"
                    ]
                }
            ]
        }
    ]
}
