#: src/ui/components/ZenSettingsDialog.qml:619
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"\"Devices\" is the bottom (right, if docked horizontally) section of "
"ZenPanel. It lists removable media, mounted partitions, and optionally "
"network devices. It collapses, if not in use, but individual devices, or the "
"section itself can be pinned."
msgstr ""
"Der \"Geräte\"-Bereich stellt den unteren (rechten, wenn horizontal "
"angeheftet) Bereich des ZenPanel dar. Er listet Wechsellaufwerke, "
"eingehängte Partitionen und optional Netzwerkgeräte auf. Bei Nichtbenutzung "
"klappt er automatisch zu, einzelne Geräte, oder der ganze Bereich können "
"dauerhaft angeheftet werden."

